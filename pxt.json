        "src/platform/platform_ports.h",
        "src/core/heading_wrap.h",
        "src/core/encoder_glitch_armor.h",
        "src/core/bus_guard.h",
        "src/core/motion_owner.h",
        "src/core/fiber_identity.h",
        "src/platform/i2c_bus.h",
        "src/platform/microbit_i2c_bus.cpp",
        "src/platform/nezha_port.h",
